{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yovel:v1:event.order",
  "title": "event.order — 주문 생애주기 (클라 → 서버)",
  "description": "원장·지연 실측용이며 제어 경로가 아니다 (제어는 state.snapshot). ★ signal_ts / submitted_at / filled_at 3종을 전부 실어야 '신호→체결' 지연을 잴 수 있다.",
  "type": "object",
  "additionalProperties": true,
  "required": ["intent_id", "phase", "symbol", "side"],
  "properties": {
    "intent_id": { "$ref": "urn:yovel:v1:common#/$defs/Ulid" },
    "phase": { "enum": ["submitted", "filled", "partial", "rejected", "canceled", "exit_filled"] },
    "symbol": { "$ref": "urn:yovel:v1:common#/$defs/Symbol" },
    "side": { "enum": ["buy", "sell"] },
    "qty": { "type": "number", "minimum": 0 },
    "price": { "type": "number", "minimum": 0 },
    "broker_order_id": { "type": "string", "maxLength": 64 },
    "signal_ts": {
      "$ref": "urn:yovel:v1:common#/$defs/Timestamp",
      "description": "이 주문을 낳은 intent.target 의 as_of_bar."
    },
    "submitted_at": { "$ref": "urn:yovel:v1:common#/$defs/Timestamp" },
    "filled_at": { "$ref": "urn:yovel:v1:common#/$defs/Timestamp" },
    "slippage_bp": {
      "type": "number",
      "description": "기준가 대비 체결 슬리피지(bp). ★ 엔진이 이미 반영한 비용을 집계에서 또 빼지 말 것."
    },
    "fee_krw": { "type": "number", "minimum": 0 },
    "exit_reason": { "enum": ["stop", "tp", "time", "derisk", "manual", "broker"] },
    "realized_pct": { "type": "number" },
    "broker_code": { "type": "string", "maxLength": 64 },
    "detail": { "type": "string", "maxLength": 500 },
    "exec": {
      "type": "object",
      "additionalProperties": true,
      "description": "집행 방식 sweep 의 내역 (그 외엔 없음). qty·price 는 모든 조각의 합·평단 (protocol.md §4.1.3).",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["sweep"] },
        "cap_price": { "type": "number", "exclusiveMinimum": 0, "description": "매수 — 받은 값 그대로." },
        "floor_price": { "type": "number", "exclusiveMinimum": 0, "description": "매도 — 받은 값 그대로." },
        "sweep_until": { "$ref": "urn:yovel:v1:common#/$defs/Timestamp", "description": "콕핏이 실제로 쓴 창 끝." },
        "ref_ask1": { "type": "number", "minimum": 0, "description": "집행을 시작한 순간 콕핏이 본 매도1." },
        "ref_bid1": { "type": "number", "minimum": 0, "description": "집행을 시작한 순간 콕핏이 본 매수1." },
        "ref_at": { "$ref": "urn:yovel:v1:common#/$defs/Timestamp" },
        "fills": {
          "type": "array",
          "description": "체결된 조각 (주문번호 단위 합).",
          "items": {
            "type": "object",
            "required": ["order_id", "kind", "at", "price", "qty"],
            "properties": {
              "order_id": { "type": "string" },
              "kind": { "enum": ["ioc", "rest"] },
              "at": { "$ref": "urn:yovel:v1:common#/$defs/Timestamp" },
              "price": { "type": "number", "minimum": 0 },
              "qty": { "type": "number", "minimum": 0 },
              "fee_krw": { "type": "number", "minimum": 0 }
            }
          }
        },
        "order_ids": { "type": "array", "items": { "type": "string" }, "description": "낸 증권사 주문번호 전부 (0 체결 IOC 포함)." },
        "ioc_orders": { "type": "integer", "minimum": 0 },
        "rest_qty": { "type": "number", "minimum": 0, "description": "창 끝 시장가로 산/판 수량." },
        "rest_price": { "type": "number", "minimum": 0, "description": "창 끝 시장가 평단." },
        "ended": {
          "enum": ["all", "window", "stop", "time", "session", "slip", "short", "unknown", "error"],
          "description": "창을 닫은 사유."
        },
        "detail": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "phase": { "const": "exit_filled" } }, "required": ["phase"] },
      "then": { "required": ["exit_reason"] }
    }
  ]
}
